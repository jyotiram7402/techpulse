# ===================================================================
# Supabase (REQUIRED) — create a free project at https://supabase.com
# Values: Supabase dashboard → Project Settings → API. NEXT_PUBLIC_*
# values are inlined at build time; the service-role key is server-only.
# ===================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===================================================================
# Cron security — any random long string. The GitHub Actions cron
# workflows and Vercel's daily cron send it as "Authorization: Bearer …".
# Leave it empty only locally: when unset, /api/cron/* is open.
# ===================================================================
CRON_SECRET=replace-with-a-long-random-string

# ===================================================================
# Hugging Face Inference API (OPTIONAL — falls back to rule-based
# summarization if absent). Free tier token from https://huggingface.co/settings/tokens
# ===================================================================
HUGGINGFACE_API_KEY=

# ===================================================================
# Site URL (used for SEO metadata, OG, sitemap)
# ===================================================================
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ===================================================================
# Not read by the app: GitHub Actions secrets for the cron workflows
# (repo → Settings → Secrets and variables → Actions):
#   SITE_URL     production base URL, no trailing slash
#   CRON_SECRET  same value as CRON_SECRET above
# ===================================================================
